[app]
host="0.0.0.0"
port=8000
name="fami-boilerplate-service"
debug=true
env="development"
# where the background jobs call back (/v1/queue/*)
base_url=""

[grpc]
host="0.0.0.0"
port=5000

[jwt]
key="<jwt-signing-key>"

[sentry]
enabled=true
dsn="localhost"
timeout="5s"

[trace]
enabled=true

  [trace.jaeger]
  host="localhost"
  port="14268"

[metric]
enabled=true

[database]
enabled=true
connection="mysql"
name="boilerplate"
max_open_conns=280
max_idle_conns=20
conn_lifetime_max="1h"

  [database.write]
  host="0.0.0.0"
  port=3306
  username="root"
  password="password"

  [database.read]
  host="0.0.0.0"
  port=3306
  username="root"
  password="password"

[mongodb]
enabled=false
host="0.0.0.0"
port=27017
name="db-example"
username="root"
password="secret"

[redis]
enabled=true
host="0.0.0.0"
port=6379
namespace=1
username="root"
password="secret"
conn_lifetime_max="1h"
dial_timeout="5s"
write_timeout="5s"
read_timeout="5s"
idle_timeout="10s"

[s3]
enabled=false
endpoint="sgp1.digitaloceanspaces.com"
bucket_name=""
access_key_id=""
secret_access_key=""
token=""
use_ssl=true

[client]
enabled=false

  [client.account_service_grpc]
  enabled=false
  host="0.0.0.0"
  port=5001
  timeout="30s"
  max_concurrent_requests=30
  error_percent_threshold=20
  tls=false
  pem_tls_path=""
  secret=""
  realtime=true

  [client.audit_service_grpc]
  enabled=false
  host="0.0.0.0"
  port=5002
  timeout="30s"
  max_concurrent_requests=30
  error_percent_threshold=20
  tls=false
  pem_tls_path=""
  secret=""
  realtime=true

  [client.configuration_service_grpc]
  enabled=false
  host="127.0.0.1"
  port=5003
  timeout="30s"
  max_concurrent_requests=30
  error_percent_threshold=20
  tls=false
  pem_tls_path=""
  secret=""
  realtime=true
  
  [client.bridge_service_grpc]
  enabled=false
  host="127.0.0.1"
  port=5004
  timeout="30s"
  max_concurrent_requests=30
  error_percent_threshold=20
  tls=false
  pem_tls_path=""
  secret=""
  realtime=true

[kafka]
enabled=false
brokers=["localhost:9092"]
version=""
username=""
password=""
tls=false
pem_tls_path=""
timeout="5s"

  [kafka.publisher]
  topic="person"

  [kafka.subscriber]
  topic="person"
  group="person-synchronize"


# --- Site Dev settings (placeholders only; real values live in devops' secret store) ---

# Basic auth of the Cloud Tasks callbacks (/v1/queue/*) and of the
# fami-module token service
[public_api]
username=""
password=""

# fami-module auth service that issues the token for approval-link logins
[approval_jwt]
base_url=""

# file storage of the site photos (TODO: storage client, plan Q4)
[gcs.upload]
temp_bucket=""
temp_prefix=""

# Gemini (called only by this backend, Google AI Studio generateContent).
# apikey empty = AI off: the AI endpoints answer 503 "Analisis AI belum
# aktif", nothing is sent to Google. Key set = AI on (key only in the
# x-goog-api-key header, never in logs or errors). timeout_seconds per try
# (60); one retry at most on Google 5xx / 429 rate limit.
[gemini]
apikey=""
model="gemini-2.5-flash"
timeout_seconds=60
# answer budget incl. the model's thinking (site-dev-api 8000 cut 1 of 6 answers)
max_output_tokens=12000

# daily limits per user (an admin can override them in Settings)
[ai_insight]
daily_quota=50

# Google Geocoding (pin address, address search). enabled=false (default):
# both endpoints answer 503, no quota used, no Google call. daily_cap =
# server-wide Google calls per day (Asia/Jakarta), on top of daily_quota per
# user. Key needs "Geocoding API" enabled on its Google Cloud project.
[geocoding]
enabled=false
apikey=""
daily_quota=100
daily_cap=150

# background jobs (approval e-mail, AI insight); false = run at once
# (TODO: Cloud Tasks client, plan Q4)
[cloud_task]
enabled=false
id=""
location=""
queue=""

# approval e-mail (TODO: the sender, plan Q4); frontend.url is the link in it
[smtp]
host=""
port="587"
username=""
password=""
from=""
from_name=""

[frontend]
url=""

# other requests nearby (local §8): duplicate check on submit;
# "off" (default, submit as before) or "confirm" (409 unless confirm_duplicate)
[nearby_request]
duplicate_check="off"
duplicate_radius_m=200

# nearby places for the map + AI (local §6); enabled=false (default):
# endpoint 503 and the AI prompt as before. Google Places (New) first when
# google_apikey is set (key needs "Places API (New)"), OpenStreetMap
# (Overpass, free) on refusal / error / daily cap / no key; the answer names
# the source. daily_cap = Google calls per day server wide (a new area =
# 7 calls with the default categories; cached per ~110 m cell, 7 days
# Google, fallback_cache_hours for OSM). categories: competitor, office,
# school, university, apartment (default ["competitor","office"]).
[places]
enabled=false
google_apikey=""
categories=["competitor","office"]
google_timeout_seconds=10
daily_cap=150
radius_m=500
max_radius_m=1000
cache_hours=168
fallback_cache_hours=6
ai_measured=true
ai_timeout_seconds=30
overpass_timeout_seconds=25
overpass_deadline_seconds=60
overpass_user_agent=""
overpass_urls=[]

# on-site survey (November scope, API-CHANGES §13.5): true = sending
# (SUBMITED) needs context.vehicle_traffic_level; false (default) until the
# web app sends it
[survey]
traffic_required_on_submit=false
